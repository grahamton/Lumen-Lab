{
  "name": "lumen-lab",
  "private": true,
  "version": "1.3.0",
  "description": "Real-time, audio-reactive visual synthesizer with projection mapping for VJs and artists.",
  "author": "grahamton",
  "homepage": "https://github.com/grahamton/Lumen-Lab",
  "license": "GPL-3.0",
  "type": "module",
  "main": "electron/main.js",
  "desktopName": "lumen-lab.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:build": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.556.0",
    "playwright-core": "^1.61.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "three": "^0.186.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "zustand": "^5.0.9"
  },
  "build": {
    "appId": "com.lumenlab.app",
    "productName": "Lumen Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grahamton",
        "repo": "Lumen-Lab"
      }
    ]
  }
}
